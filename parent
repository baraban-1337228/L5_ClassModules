export class Task {
    #title;
    #priority;
    #completed;
 constructor (title,priority,completed)
 {
    this.title = String(title);
    this.priority = Number(priority);
    this.completed = Boolean(completed);
 }
get title()
{
    return this.#title;
}
set title (value) {
    this.#title = value;
}
get priority ()
{
    return this.#priority;
}
set priority (value)
{
   this.#priority = value;
}
get completed ()
{
    return this.#completed;
}
set completed (value)
{
 this.#completed = value; 
}
show () {
    console.log ({title: this.#title,priority: this.#priority,completed:this.#completed});
}
delete () {
    this.#title = undefined;
    this.#priority = undefined;
    this.#completed = undefined;
}
copy () {
    return this;
}
#toggleStatus() {
    if (this.#completed == true) { this.#completed = false}
    else if (this.#completed == false) { this.#completed = true} 
}
static clone (notOrig) {
return new Task (notOrig.title, notOrig.priority,notOrig.completed);
}
}
